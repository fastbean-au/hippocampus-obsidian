{
	"name": "hippocampus-obsidian",
	"version": "0.4.0",
	"description": "Obsidian plugin bridging a vault to a Hippocampus memory service over its HTTP/JSON gateway.",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc --noEmit --skipLibCheck && node esbuild.config.mjs production",
		"test": "node --test --import tsx test/*.test.ts"
	},
	"keywords": [
		"obsidian",
		"hippocampus",
		"memory"
	],
	"author": "fastbean-au",
	"license": "MIT",
	"devDependencies": {
		"@bufbuild/protobuf": "^2.17.0",
		"@types/node": "^26.6.6",
		"builtin-modules": "^5.5.0",
		"esbuild": "^0.28.2",
		"obsidian": "^1.14.4",
		"tsx": "^4.23.15",
		"typescript": "^7.0.2"
	},
	"allowScripts": {
		"esbuild@0.28.2": true,
		"fsevents@2.3.3": true
	},
	"overrides": {
		"moment": "^2.31.0"
	},
	"dependencies": {
		"hippocampus-client": "https://github.com/fastbean-au/hippocampus/releases/download/v0.55.0/hippocampus-client-0.55.0.tgz"
	}
}
